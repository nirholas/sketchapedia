  },
  "bugs": {
    "url": "https://github.com/nirholas/sketchapedia/issues"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=10",
    "bun": ">=1.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules/.cache .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='@sketchapedia/*' && changeset publish",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
